import { getAppSettings, getIceCreamFlavors, getIceCreamPotes, getDailyMenus, getImperdibles, getPizzaFlavors, getEmpanadasFlavors, getMilanesaSettings, getDeliveryConfig } from "@/lib/actions/settings";
